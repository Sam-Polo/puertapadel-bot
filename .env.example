# ============================================================
#  PuertaPadel bot — конфигурация
#  Скопируй в .env и заполни:  cp .env.example .env
# ============================================================

# --- Обязательное ---

# Токен бота от @BotFather
BOT_TOKEN=123456:AAAA-BBBB_CCCC

# Username бота без @ — нужен для сборки deep-link'ов в анонсах
BOT_USERNAME=PuertaPadel_bot

# Telegram ID администраторов через запятую.
# Свой ID можно узнать у @userinfobot
ADMIN_IDS=123456789,987654321

# Ссылка на пользовательское соглашение / согласие на обработку
# персональных данных (Google Docs с доступом "по ссылке")
AGREEMENT_URL=https://docs.google.com/document/d/CHANGE_ME

# --- Анонсы (опционально) ---

# ID чата, куда бот публикует анонсы турниров.
# Для групп/супергрупп это отрицательное число: -1001234567890
# Как узнать: добавь бота в чат админом и выполни /chatid в этом чате.
# Если не задано — анонсы не публикуются, бот работает только напрямую.
ANNOUNCE_CHAT_ID=

# ID топика в форум-супергруппе (message_thread_id).
# Оставь пустым, если чат обычный или постим в General.
# Как узнать: /chatid, отправленная внутри нужного топика.
ANNOUNCE_THREAD_ID=

# --- Прочее ---

# Часовой пояс, в котором админ вводит и все видят дату/время турниров
TZ=Europe/Moscow

# Путь к файлу БД внутри контейнера (менять обычно не нужно)
DB_PATH=/app/data/bot.sqlite3

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
